// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RH
  FINANCE
  ENSEIGNANT
}

model Utilisateur {
  id_utilisateur  Int      @id @default(autoincrement())
  email           String   @unique
  mot_de_passe    String  
  nom             String
  prenom          String
  role            Role     @default(ENSEIGNANT)
  date_creation   DateTime @default(now())

  
  id_enseignant   Int?     @unique
  enseignant      Enseignant? @relation(fields: [id_enseignant], references: [id], onDelete: SetNull)
}

model Enseignant{
  id          Int      @id @default(autoincrement())
  nom         String
  prenom      String
  email       String   @unique
  tauxHoraireBase  Float
  statut      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  utilisateur       Utilisateur?
  feuilleDeTemps FeuilleDeTemps[]
  paie Paie[]
}

model FeuilleDeTemps{
  id          Int      @id @default(autoincrement())
  enseignantId Int
  date        DateTime
  heuresEffectuees Float
  heuresSupp Float
  typeActivite String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enseignant Enseignant @relation(fields: [enseignantId], references: [id])
}

model Paie{
  id          Int      @id @default(autoincrement())
  enseignantId Int
  totalSalaire Float
  statutpaie String
  date        DateTime
  mois        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enseignant Enseignant @relation(fields: [enseignantId], references: [id])
}

model Pole{
  id          Int      @id @default(autoincrement())
  nom         String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  charges Charge[]
  revenus Revenu[]
}

model Charge{
  id          Int      @id @default(autoincrement())
  libelle     String
  montant     Float
  date        DateTime
  typeCharge  String
  idPole      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  pole Pole @relation(fields: [idPole], references: [id])
}

model Revenu{
  id          Int      @id @default(autoincrement())
  libelle     String
  montant     Float
  date        DateTime
  typeRevenu  String
  idPole      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pole Pole @relation(fields: [idPole], references: [id])
}
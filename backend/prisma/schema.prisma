// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  RH
  FINANCE
  ENSEIGNANT
}
enum STATUT_FEUILLE { 
  VALIDE
  REFUSE
  EN_ATTENTE
}

model Utilisateur {
  id_utilisateur  Int      @id @default(autoincrement())
  email           String   @unique
  mot_de_passe    String  
  nom             String
  prenom          String
  role            Role     @default(ENSEIGNANT)
  date_creation   DateTime @default(now())
  enseignant      Enseignant?
  feuillesValidees FeuilleDeTemps[] @relation("FeuillesValidees")
}

model Enseignant{
  id          Int      @id @default(autoincrement())
  tauxHoraireBase  Float
  statut      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  id_utilisateur   Int      @unique
  utilisateur      Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  feuilleDeTemps FeuilleDeTemps[]
  paie Paie[]
}

model FeuilleDeTemps{
  id          Int      @id @default(autoincrement())
  enseignantId Int
  date        DateTime
  heuresEffectuees Float
  heuresSupp Float
  typeActivite String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  statut  STATUT_FEUILLE @default(EN_ATTENTE)
  enseignant Enseignant @relation(fields: [enseignantId], references: [id])
  valideParId      Int?
  validePar        Utilisateur?  @relation("FeuillesValidees", fields: [valideParId], references: [id_utilisateur])
}

model Paie{
  id          Int      @id @default(autoincrement())
  enseignantId Int
  totalSalaire Float
  statutpaie String
  date        DateTime
  mois        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enseignant Enseignant @relation(fields: [enseignantId], references: [id])
}

model Pole{
  id          Int      @id @default(autoincrement())
  nom         String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  charges Charge[]
  revenus Revenu[]
}

model Charge{
  id          Int      @id @default(autoincrement())
  libelle     String
  montant     Float
  date        DateTime
  typeCharge  String
  idPole      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  pole Pole @relation(fields: [idPole], references: [id])
}

model Revenu{
  id          Int      @id @default(autoincrement())
  libelle     String
  montant     Float
  date        DateTime
  typeRevenu  String
  idPole      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pole Pole @relation(fields: [idPole], references: [id])
}
# PostgreSQL accessible depuis le conteneur backend.
# Encoder les caractères réservés du mot de passe dans l'URL (%40 pour @, %3A pour : …).
DATABASE_URL="postgresql://erp_app:CHANGE_ME@postgres:5432/erp_honey?schema=public"

# Nécessaire seulement aux commandes Prisma qui créent une base miroir (ex. migrate dev).
# Ne pas renseigner pour `prisma migrate deploy` en production.
# SHADOW_DATABASE_URL="postgresql://erp_migrator:CHANGE_ME@postgres:5432/erp_honey_shadow?schema=public"

# Secret aléatoire d'au moins 32 octets, différent par environnement.
JWT_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET"

# Port d'écoute de NestJS à l'intérieur du conteneur.
PORT=3000
